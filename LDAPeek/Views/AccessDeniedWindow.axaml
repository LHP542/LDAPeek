<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LDAPeek.Views"
        xmlns:controls="using:LDAPeek.Controls"
        x:Class="LDAPeek.Views.AccessDeniedWindow"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="LDAPeek — kein Zugriff"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="LDAPeek" />

        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Kein Zugriff" Classes="h1" />
                <TextBlock x:Name="LeadText" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="card">
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Angemeldet als" Classes="field-label" />
                    <SelectableTextBlock x:Name="AccountText" Grid.Column="1" Classes="field-value" />

                    <TextBlock Grid.Row="1" Text="Erforderliche Gruppe" Classes="field-label" />
                    <SelectableTextBlock x:Name="GroupText" Grid.Row="1" Grid.Column="1"
                                         Classes="field-value" />
                </Grid>
            </Border>

            <Border Classes="card"
                    Background="{DynamicResource KrosteWarningSoftBrush}"
                    BorderBrush="{DynamicResource KrosteWarningBrush}"
                    IsVisible="False" x:Name="HintCard">
                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Foreground="{DynamicResource KrosteTextBrush}" />
            </Border>

            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Wurdest du gerade erst in die Gruppe aufgenommen? Windows merkt sich die Gruppen bei der Anmeldung — nach einer Ab- und Neuanmeldung greift sie. „Erneut prüfen“ fragt zusätzlich direkt im Verzeichnis nach." />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <ProgressBar x:Name="CheckProgress" IsIndeterminate="True" Width="90"
                             VerticalAlignment="Center" IsVisible="False" />
                <Button x:Name="RetryButton" Content="Erneut prüfen" />
                <Button x:Name="CloseButton" Classes="accent" Content="Beenden" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
