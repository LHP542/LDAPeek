<Project>
  <!-- Central Package Management: EINZIGER Ort für Paketversionen.

       ACHTUNG beim Anheben: Auf dem Arbeitslaptop blockt der FortiProxy seit
       2026-08 die eigentlichen Paket-Downloads von nuget.org (HTTP 403 auf
       /v3-flatcontainer/*.nupkg), obwohl die Metadaten durchgehen und px
       sauber authentifiziert. Ein "dotnet package search" meldet deshalb
       neuere Versionen, die sich nicht laden lassen. Die Versionen hier
       entsprechen dem, was im Offline-Feed C:\NuGet-Local liegt. Vor einem
       Bump erst prüfen, ob das Paket dort vorhanden ist — sonst ist der
       Restore auf dem Arbeitsplatz kaputt, während die GitHub Actions grün
       bleiben. -->
  <ItemGroup>
    <!-- Avalonia. DiagnosticsSupport folgt NICHT der Avalonia-Version
         (eigene 2.x-Reihe).
         Avalonia.Controls.DataGrid ist bewusst NICHT referenziert: die Reihe
         hinkt der Kernversion hinterher, und ein Style-Selektor auf einen
         nicht referenzierten Typ gibt AVLN2000 nur beim ERSTEN Build (die
         XAML-Aufgabe ist inkrementell) — lokal nach einem Retry unsichtbar,
         im CI jedes Mal rot. Die Gruppenliste ist deshalb eine ListBox mit
         Grid-ItemTemplate. -->
    <PackageVersion Include="Avalonia" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- Nur Debug-Builds referenzieren dieses Paket (DevTools) -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />

    <!-- MVVM & DI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- Logging -->
    <PackageVersion Include="NLog" Version="6.2.0" />

    <!-- Active Directory: reines LDAP über System.DirectoryServices.Protocols.
         Kein System.DirectoryServices/AccountManagement — die gehen über
         ADSI/COM, verstecken die tatsächlich angeforderten Attribute und machen
         Range-Retrieval und LDAP_MATCHING_RULE_IN_CHAIN unnötig umständlich. -->
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.5" />
    <!-- DPAPI für das optionale Dienstkonto-Passwort in den Einstellungen -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />

    <!-- Versionierung -->
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Tests (xunit.v3, NICHT das alte "xunit"-Paket, v2 ist deprecated);
         FluentAssertions NICHT auf 8.x heben (kommerzielle Xceed-Lizenz) -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>
</Project>
